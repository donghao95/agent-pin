{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Pin",
  "version": "0.1.0",
  "identifier": "com.agentpin.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1800",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Agent Pin",
    "category": "Productivity",
    "shortDescription": "Agent Pin - 让 Agent 把重要内容贴到桌面上",
    "longDescription": "Agent Pin 是一个本地桌面工具，让 Agent 可以通过 CLI / HTTP 把 Markdown、图片和状态信息推送成独立桌面 Pin 窗口。MVP 不做 choice、不做点击反馈、不做 Artifact。",
    "copyright": "Copyright © 2026 Agent Pin Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
