{
  "name": "agent-pin",
  "private": true,
  "version": "0.1.0",
  "description": "Agent Pin - 让 Agent 把重要内容贴到桌面上",
  "scripts": {
    "dev": "pnpm --filter @agent-pin/desktop tauri dev",
